PORT=8080

# 以下字段仅用于历史/开发参考，实际部署与 Prisma ORM 均只读取 DATABASE_URL。
DB_HOST=localhost
DB_PORT=5432
DB_USER=ironai_user
DB_PASSWORD=your_db_password
DB_NAME=ironai

# ============================================================
# Prisma / PostgreSQL 连接串（必设）
# ------------------------------------------------------------
# 模板：postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres
#
# 【必填参数】（代码层也会自动补全，但在 Vercel env 里直接写全更直观）
#   pgbouncer=true           — 告诉 Prisma 运行在 PgBouncer 之后（禁用 PgBouncer 不支持的语句）
#   statement_cache_size=0   — 关键！关闭 Prisma 客户端侧 named prepared statement 缓存
#                              解决 PgBouncer 模式下的 "prepared statement sX already exists"
#   connection_limit=1       — Vercel Serverless：每个函数实例只开 1 条连接，防止打满 DB
#   connect_timeout=15       — 建连超时
#   pool_timeout=15          — 从连接池取连接的超时
#
# Supabase 海外连接池（Transaction Pooler，端口 6543）
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres.你的项目ID:你的密码@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0&connection_limit=1&connect_timeout=15&pool_timeout=15

# JWT 签名密钥（建议 64 位十六进制）
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_random_64_byte_hex_string

# DeepSeek AI 服务密钥
DEEPSEEK_API_KEY=sk-your_deepseek_api_key
